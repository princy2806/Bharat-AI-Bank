// Step 16: Mutual Fund Account Statements (CAS - Consolidated Account Statement)
// For: Rajesh Sharma, Priya Patel, Sunita Devi, Meera Nair, Kavitha Reddy, Anita Sharma
// Document AI Template: MUTUAL_FUND_STATEMENT
// Fields: Folio No, Fund Name, Investor Name, PAN, Units Held,
//         NAV, Current Value, SIP Amount, SIP Date, Returns%

Map<String, Id> accMap = new Map<String, Id>();
for (Account a : [SELECT Id, FirstName, LastName FROM Account WHERE IsPersonAccount = true
    AND LastName IN ('Sharma','Patel','Devi','Nair','Reddy')
    ORDER BY CreatedDate DESC]) {
    String key = a.FirstName + ' ' + a.LastName;
    if (!accMap.containsKey(key)) accMap.put(key, a.Id);
}
for (Account a : [SELECT Id, FirstName, LastName FROM Account WHERE FirstName='Anita' AND LastName='Sharma' AND IsPersonAccount=true LIMIT 1]) {
    accMap.put('Anita Sharma', a.Id);
}

List<ContentVersion> cvs = new List<ContentVersion>();

