<?xml version="1.0" encoding="UTF-8"?>
<!--
    Flow: Banking_Customer_Verification_OTP
    Type: Screen Flow (invoked by Agentforce Service Agent)
    Purpose: Collects customer identifier → calls BankingCustomerService
             → generates OTP → validates OTP → sets session variable
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <label>Banking Customer Verification OTP</label>
    <processType>Flow</processType>
    <status>Active</status>
    <interviewLabel>Banking Customer Verification OTP {!$Flow.CurrentDateTime}</interviewLabel>

    <!-- ═══════════════════════════════════════════════════
         VARIABLES
    ═══════════════════════════════════════════════════ -->

    <variables>
        <name>varCustomerInput</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Customer ID, mobile, or email entered by customer</description>
    </variables>

    <variables>
        <name>varCustomerRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <name>varIsVerified</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>

    <variables>
        <name>varIsLocked</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>

    <variables>
        <name>varResponseMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <name>varEnteredOTP</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- ═══════════════════════════════════════════════════
         START ELEMENT
    ═══════════════════════════════════════════════════ -->

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Action_VerifyCustomer</targetReference>
        </connector>
    </start>

    <!-- ═══════════════════════════════════════════════════
         ACTION: Verify Customer (BankingCustomerService)
    ═══════════════════════════════════════════════════ -->

    <actionCalls>
        <name>Action_VerifyCustomer</name>
        <label>Verify Customer Identity</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <actionName>BankingCustomerService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Decision_CustomerFound</targetReference>
        </connector>
        <inputParameters>
            <name>inputValue</name>
            <value>
                <elementReference>varCustomerInput</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <name>customerFound</name>
            <assignToReference>varCustomerFound</assignToReference>
        </outputParameters>
        <outputParameters>
            <name>customerRecordId</name>
            <assignToReference>varCustomerRecordId</assignToReference>
        </outputParameters>
        <outputParameters>
            <name>responseMessage</name>
            <assignToReference>varResponseMessage</assignToReference>
        </outputParameters>
        <outputParameters>
            <name>isLocked</name>
            <assignToReference>varIsLocked</assignToReference>
        </outputParameters>
    </actionCalls>

    <!-- ═══════════════════════════════════════════════════
         DECISION: Was customer found?
    ═══════════════════════════════════════════════════ -->

    <decisions>
        <name>Decision_CustomerFound</name>
        <label>Customer Found?</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>End_CustomerNotFound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Rule_CustomerFoundAndNotLocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCustomerFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varIsLocked</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Action_GenerateOTP</targetReference>
            </connector>
            <label>Found and Not Locked</label>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════════════════
         ACTION: Generate OTP (BankingOTPService)
    ═══════════════════════════════════════════════════ -->

    <actionCalls>
        <name>Action_GenerateOTP</name>
        <label>Generate and Send OTP</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <actionName>BankingOTPService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Screen_EnterOTP</targetReference>
        </connector>
        <inputParameters>
            <name>customerRecordId</name>
            <value>
                <elementReference>varCustomerRecordId</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <name>responseMessage</name>
            <assignToReference>varResponseMessage</assignToReference>
        </outputParameters>
    </actionCalls>

    <!-- ═══════════════════════════════════════════════════
         SCREEN: Enter OTP (shown in Service Agent chat)
    ═══════════════════════════════════════════════════ -->

    <screens>
        <name>Screen_EnterOTP</name>
        <label>Enter OTP</label>
        <locationX>50</locationX>
        <locationY>650</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <connector>
            <targetReference>Action_ValidateOTP</targetReference>
        </connector>
        <fields>
            <name>OTPInstructions</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>{!varResponseMessage}</fieldText>
        </fields>
        <fields>
            <name>OTPInput</name>
            <dataType>String</dataType>
            <fieldType>InputField</fieldType>
            <fieldText>Enter OTP</fieldText>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varEnteredOTP</assignToReference>
            </outputParameters>
        </fields>
    </screens>

    <!-- ═══════════════════════════════════════════════════
         ACTION: Validate OTP (BankingOTPService)
    ═══════════════════════════════════════════════════ -->

    <actionCalls>
        <name>Action_ValidateOTP</name>
        <label>Validate OTP</label>
        <locationX>50</locationX>
        <locationY>800</locationY>
        <actionName>BankingOTPService.validateOTP</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Decision_OTPResult</targetReference>
        </connector>
        <inputParameters>
            <name>customerRecordId</name>
            <value><elementReference>varCustomerRecordId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>enteredOTP</name>
            <value><elementReference>varEnteredOTP</elementReference></value>
        </inputParameters>
        <outputParameters>
            <name>isValid</name>
            <assignToReference>varIsVerified</assignToReference>
        </outputParameters>
        <outputParameters>
            <name>isLocked</name>
            <assignToReference>varIsLocked</assignToReference>
        </outputParameters>
        <outputParameters>
            <name>responseMessage</name>
            <assignToReference>varResponseMessage</assignToReference>
        </outputParameters>
    </actionCalls>

    <!-- ═══════════════════════════════════════════════════
         DECISION: OTP Result
    ═══════════════════════════════════════════════════ -->

    <decisions>
        <name>Decision_OTPResult</name>
        <label>OTP Valid?</label>
        <locationX>50</locationX>
        <locationY>950</locationY>
        <defaultConnector>
            <targetReference>End_OTPFailed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid OTP</defaultConnectorLabel>
        <rules>
            <name>Rule_OTPValid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsVerified</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>End_Verified</targetReference>
            </connector>
            <label>OTP Valid</label>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════════════════
         END ELEMENTS
    ═══════════════════════════════════════════════════ -->

    <recordLookups>
        <name>End_Verified</name>
        <label>Verification Complete</label>
        <locationX>50</locationX>
        <locationY>1100</locationY>
        <!-- Flow ends; varIsVerified=true returned to Agent -->
    </recordLookups>

    <recordLookups>
        <name>End_OTPFailed</name>
        <label>OTP Failed</label>
        <locationX>300</locationX>
        <locationY>1100</locationY>
    </recordLookups>

    <recordLookups>
        <name>End_CustomerNotFound</name>
        <label>Customer Not Found</label>
        <locationX>500</locationX>
        <locationY>500</locationY>
    </recordLookups>

</Flow>
