<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <label>Status</label>
    <description>The current status of the credit card transaction</description>
    <inlineHelpText>Transaction status: Posted (completed), Pending (processing), or Disputed (under investigation)</inlineHelpText>
    <type>Picklist</type>
    <required>true</required>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Posted</fullName>
                <default>true</default>
                <label>Posted</label>
            </value>
            <value>
                <fullName>Pending</fullName>
                <default>false</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Disputed</fullName>
                <default>false</default>
                <label>Disputed</label>
            </value>
            <value>
                <fullName>Reversed</fullName>
                <default>false</default>
                <label>Reversed</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>